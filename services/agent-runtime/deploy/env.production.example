# /opt/devroom/app/services/agent-runtime/.env on the VM.
# Same Postgres instance as the web app's DATABASE_URL.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Must exactly match DEVROOM_AGENT_SERVICE_TOKEN in the web app's Vercel env.
DEVROOM_AGENT_SERVICE_TOKEN="REPLACE_WITH_GENERATED_TOKEN"

DEVROOM_SANDBOX_IMAGE="devroom-sandbox:prod"

# "fake" = deterministic stub, no LLM calls.
# "anthropic" = real model via Anthropic, requires ANTHROPIC_API_KEY.
# "openai" = real model via OpenAI, requires OPENAI_API_KEY.
DEVROOM_MODEL_PROVIDER="openai"
DEVROOM_MODEL_NAME="gpt-5.2"
OPENAI_API_KEY="REPLACE_WITH_OPENAI_KEY"

DEVROOM_REPOSITORIES_JSON='{"agentguard-demo":{"display_name":"AgentGuard demo repository","source_path":"/opt/devroom/repos/agentguard-demo","allowed_paths":["backend/**","tests/**"],"test_command":"python -m pytest -q","language":"python"}}'

# The Vercel app's public URL — the runtime posts run-update callbacks here.
DEVROOM_WEB_CALLBACK_URL="https://your-app.vercel.app"

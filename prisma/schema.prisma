// Dev Room — Stage 1 schema.
// PostgreSQL is the single source of truth for all durable application state.
// Liveblocks holds ONLY ephemeral awareness (presence, comment threads) and is
// never persisted here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  ENGINEER
  VIEWER
}

enum AgentTaskStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE
}

/// How much scrutiny a task's result deserves. Declared by a human, never
/// inferred from a scan — this is a review-routing hint, not a safety verdict.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// --- Stage 2: coding-agent runs -------------------------------------------

enum AgentRunStatus {
  QUEUED
  RUNNING
  // Stage 3: the agent has produced a plan and is paused before writing any
  // files, waiting for a human approve/reject decision.
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
  // --- Agent Dev Room pivot: states an externally-run agent (or a human)
  // can put a run into. Appended, never reordered — Postgres enum values are
  // append-only, so no existing row changes meaning.
  //
  // The agent stopped and needs a human answer before it can continue.
  WAITING_FOR_INPUT
  // A human marked the run blocked (dependency, decision, missing access).
  BLOCKED
  // Work is finished and awaiting human review, typically with a linked PR.
  REVIEW_READY
  // The linked pull request was merged.
  MERGED
  // Deliberately dropped without merging — distinct from FAILED, which means
  // the run itself broke.
  ABANDONED
}

enum RunArtifactType {
  PLAN
  DIFF
  TEST_RESULT
  SUMMARY
  LOG
  // Phase 5: reviewer-agent's structured review of another run's diff.
  REVIEW
}

enum RunEventType {
  RUN_CREATED
  SANDBOX_PREPARED
  // Phase 1a: a network-enabled setup phase installed the repo's own
  // declared dependencies before the (network-isolated) agent phase began.
  DEPENDENCIES_INSTALLED
  REPOSITORY_INSPECTED
  PLAN_CREATED
  // Stage 3: human-in-the-loop approval gate.
  APPROVAL_REQUESTED
  PLAN_APPROVED
  PLAN_REJECTED
  FILE_PATCHED
  TESTS_STARTED
  TESTS_FINISHED
  DIFF_CAPTURED
  RUN_SUCCEEDED
  RUN_FAILED
  RUN_CANCELLED
  // MVP Phase 1: human control primitives.
  CANCELLATION_REQUESTED
  REDIRECT_REQUESTED
  REDIRECT_APPLIED
  OWNERSHIP_TRANSFERRED
  EDITS_STARTED
  // MVP Phase 3/4: delivery + reuse.
  PR_DRAFTED
  PLAYBOOK_SAVED
  // Phase 1b: iterative repository comprehension.
  TOOL_CALL
  REPO_EXPLORATION_FINISHED
  // Phase 3: guidance arrived and cooperatively aborted an actively-running
  // run (not just one waiting at the approval gate), which then re-planned.
  RUN_STEERED
  // Phase 5: reviewer-agent posted a structured review of another run.
  REVIEW_REQUESTED
  REVIEW_POSTED
  // --- Agent Dev Room pivot: reported by external agent adapters through
  // the ingestion contract. Appended, never reordered.
  AGENT_STARTED
  AGENT_PROGRESS
  COMMAND_EXECUTED
  ERROR_DETECTED
  DECISION_RECORDED
  HANDOFF_REQUESTED
  RISK_FLAGGED
  PR_LINKED
  PR_UPDATED
  REVIEW_READY
  RUN_MERGED
  RUN_ABANDONED
}

/// What kind of human intervention was recorded against a run.
enum RunInterventionKind {
  REDIRECT
  HANDOFF
  CANCEL
}

enum RunInterventionStatus {
  PENDING
  APPLIED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdRooms     Room[]           @relation("RoomCreatedBy")
  memberships      RoomMembership[]
  createdTasks     AgentTask[]      @relation("TaskCreatedBy")
  assignedTasks    AgentTask[]      @relation("TaskAssignee")
  requestedRuns    AgentRun[]       @relation("RunRequestedBy")
  ownedRuns        AgentRun[]       @relation("RunOwnedBy")
  interventions    RunIntervention[] @relation("InterventionAuthor")
  createdPlaybooks Playbook[]       @relation("PlaybookCreatedBy")
  githubConnections GitHubConnection[] @relation("GitHubConnectionCreatedBy")

  @@index([email])
}

model Room {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  repositoryName String?
  repositoryUrl  String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy        User                   @relation("RoomCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  memberships      RoomMembership[]
  tasks            AgentTask[]
  agentRuns        AgentRun[]
  playbooks        Playbook[]
  githubConnection GitHubConnection?
  repositories     RepositoryConnection[]

  @@index([createdById])
}

model RoomMembership {
  id        String         @id @default(cuid())
  roomId    String
  userId    String
  role      MembershipRole @default(ENGINEER)
  createdAt DateTime       @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user has exactly one membership per room.
  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
}

model AgentTask {
  id          String         @id @default(cuid())
  roomId      String
  title       String
  description String?
  status      AgentTaskStatus @default(BACKLOG)
  priority    TaskPriority    @default(MEDIUM)
  assigneeId  String?
  // Fractional-friendly ordering position within a (room, status) column.
  position    Float          @default(0)
  // Optimistic-concurrency token. Starts at 1, incremented on every mutation.
  version     Int            @default(1)
  createdById String

  // --- Agent Dev Room pivot: what the agent is being asked to do, and how
  // much scrutiny the result deserves. All nullable/defaulted so every
  // pre-existing task row remains valid.
  //
  // `objective` is the instruction given to the agent; `description` remains
  // the human-facing context on the board card. They are deliberately separate:
  // a reviewer needs to know what the agent was *told*, not just what the card
  // said.
  objective          String?
  // Definition of done, surfaced to reviewers in the work packet.
  acceptanceCriteria String?
  // Drives risk surfacing and work-queue filtering. Not a security verdict —
  // a human-declared judgement about how much review this change deserves.
  riskLevel          RiskLevel @default(MEDIUM)
  // Which agent is doing the work: "devroom-builtin" for the in-repo LangGraph
  // runtime, or an external adapter ("claude_code", "codex", "cursor",
  // "custom"). Free-form on purpose — new adapters must not require a
  // migration.
  agentProvider      String?
  // GitHub issue this task addresses, if any. A URL rather than an id so it
  // stays meaningful without a live GitHub connection.
  linkedIssueUrl     String?
  // Blockers and questions the team needs to answer, shown on the work packet.
  openQuestions      String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  agentRuns AgentRun[]

  // Board fetch and column ordering: rooms/status/position.
  @@index([roomId, status, position])
  @@index([assigneeId])
  @@index([createdById])
}

/// A single coding-agent execution against a task. Durable state lives here;
/// the Python runtime updates status/artifacts/events. LangGraph checkpoints are
/// stored separately in the `langgraph` schema and are NOT modeled by Prisma.
model AgentRun {
  id                  String         @id @default(cuid())
  roomId              String
  taskId              String
  requestedById       String
  // Phase 1: who is currently responsible for this run. Starts as the
  // requester and changes on hand-off. Does NOT gate other authorized members'
  // safety controls (any OWNER/ENGINEER may still cancel).
  ownerUserId         String?
  agentId             String         @default("backend-agent")
  status              AgentRunStatus @default(QUEUED)
  graphThreadId       String         @unique
  // Sandbox id is operational metadata; never exposed to browser clients.
  sandboxId           String?
  targetRepositoryKey String
  baseRevision        String?
  startedAt           DateTime?
  finishedAt          DateTime?
  errorCode           String?
  errorSummary        String?
  // Phase 1: cooperative cancellation. Set when a human requests a stop; the
  // runtime observes it at the next safe checkpoint and tears down.
  cancelRequestedAt   DateTime?
  cancelRequestedById String?
  // Phase 4: the playbook this run was started from, if any.
  playbookId          String?
  // Fork (roadmap Phase 4): the run this one was forked from, if any. A fork
  // is only ever taken from a run parked at the approval gate — the copied
  // LangGraph checkpoint reproduces that exact paused state on a fresh
  // thread, so the fork starts AWAITING_APPROVAL with the same proposed plan,
  // free to be approved, rejected, or redirected independently of its parent.
  parentRunId         String?
  // The parent's most recent RunEvent.id at the moment of forking — purely
  // informational (never a strict FK; the parent's events keep evolving
  // independently after a fork), so the UI can show "forked after event N".
  forkedAtEvent       String?
  // Reviewer-agent (roadmap Phase 5): the run this one reviews, if any. Unlike
  // a fork, a review run shares the source's OWN task rather than cloning
  // one — it never touches the repository or sandbox, so there is nothing to
  // diverge, and by the time a review can start (source status SUCCEEDED) the
  // task's active-run slot is already free.
  reviewedRunId       String?
  // The external agent session this run represents (Agent Dev Room pivot).
  // Null for the built-in runtime, whose session identity is graphThreadId.
  // Ingestion resolves (taskId, agentSessionId) to a run so an adapter can
  // publish a whole session's events without tracking our run ids.
  agentSessionId      String?
  // Bumped on every status change (a lightweight change token for polling).
  runVersion          Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Enforces "at most one active run per task" at the DATABASE level: this is
  // set to `taskId` while QUEUED/RUNNING and null once terminal. Postgres
  // permits many NULLs but only one non-null value per task, so two active
  // runs for the same task are impossible even under concurrency. A fork
  // deliberately lives on its OWN cloned task (see `forkRun()`) rather than
  // sharing the parent's, so this invariant never has to be relaxed for it.
  activeTaskId String? @unique

  room          Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  task          AgentTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy   User              @relation("RunRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  owner         User?             @relation("RunOwnedBy", fields: [ownerUserId], references: [id], onDelete: SetNull)
  playbook      Playbook?         @relation("PlaybookRuns", fields: [playbookId], references: [id], onDelete: SetNull)
  parent        AgentRun?         @relation("RunForks", fields: [parentRunId], references: [id], onDelete: SetNull)
  forks         AgentRun[]        @relation("RunForks")
  reviewedRun   AgentRun?         @relation("RunReviews", fields: [reviewedRunId], references: [id], onDelete: SetNull)
  reviews       AgentRun[]        @relation("RunReviews")
  artifacts     RunArtifact[]
  events        RunEvent[]
  interventions RunIntervention[]
  pullRequest   PullRequestLink?
  savedPlaybook Playbook?         @relation("PlaybookSourceRun")

  @@index([taskId, createdAt])
  @@index([roomId])
  @@index([status])
  // Metrics: bounded aggregation by room/status over a date window.
  @@index([roomId, status, createdAt])
  @@index([taskId, status])
  @@index([ownerUserId])
  @@index([parentRunId])
  @@index([reviewedRunId])
  @@index([taskId, agentSessionId])
}

/// An auditable human intervention against a run (redirect, hand-off, cancel).
/// Durable and append-only: this is the record of who steered the agent and why.
model RunIntervention {
  id           String                @id @default(cuid())
  runId        String
  authorUserId String
  kind         RunInterventionKind
  status       RunInterventionStatus @default(PENDING)
  /// REDIRECT: the guidance text a human gave the agent.
  guidance     String?
  /// HANDOFF: previous and new run owner.
  fromUserId   String?
  toUserId     String?
  reason       String?
  createdAt    DateTime              @default(now())
  appliedAt    DateTime?

  run    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  author User     @relation("InterventionAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([runId, kind, status])
}

/// Append-only durable output of a run (plan, diff, test result, summary, log).
model RunArtifact {
  id          String          @id @default(cuid())
  runId       String
  type        RunArtifactType
  title       String
  contentText String?
  contentJson Json?
  metadataJson Json?
  sequence    Int
  createdAt   DateTime        @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Monotonic, unique sequence per run — also prevents accidental duplicates.
  @@unique([runId, sequence])
  @@index([runId, type])
}

/// A reusable, sanitized recipe distilled from a successful run.
/// Deliberately stores a *recipe*, never secrets, host paths, sandbox ids or a
/// full private diff.
model Playbook {
  id                     String   @id @default(cuid())
  roomId                 String
  createdById            String
  /// The successful run this playbook was distilled from (at most one).
  sourceRunId            String?  @unique
  title                  String
  description            String?
  /// Simple string tags; Postgres text[] keeps filtering cheap without a join.
  tags                   String[] @default([])
  agentId                String   @default("backend-agent")
  repositoryConnectionId String?
  /// The reusable task instruction template shown to the next user.
  templatePrompt         String
  /// A sanitized outline of the plan that worked.
  planTemplate           String?
  /// Safe, non-secret metadata (e.g. approval expectations, test summary).
  policyJson             Json?
  usageCount             Int      @default(0)
  isArchived             Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  room                 Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy            User                  @relation("PlaybookCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  sourceRun            AgentRun?             @relation("PlaybookSourceRun", fields: [sourceRunId], references: [id], onDelete: SetNull)
  repositoryConnection RepositoryConnection? @relation(fields: [repositoryConnectionId], references: [id], onDelete: SetNull)
  runs                 AgentRun[]            @relation("PlaybookRuns")

  @@index([roomId, isArchived, updatedAt])
}

/// A room's connection to GitHub. Credential material is NEVER serialized to
/// the browser and is referenced indirectly (see lib/github/credentials).
model GitHubConnection {
  id             String   @id @default(cuid())
  roomId         String   @unique
  /// GitHub App installation id or account login, depending on auth mode.
  accountLogin   String
  installationId String?
  /// Opaque reference to server-side credential storage. For local development
  /// this is the literal sentinel "env:GITHUB_TOKEN" (never the token itself).
  credentialRef  String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room         Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("GitHubConnectionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  repositories RepositoryConnection[]

  @@index([roomId])
}

/// A specific GitHub repository a room may open draft PRs against.
model RepositoryConnection {
  id            String   @id @default(cuid())
  roomId        String
  provider      String   @default("GITHUB")
  owner         String
  repo          String
  defaultBranch String   @default("main")
  connectionId  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  connection GitHubConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  playbooks  Playbook[]

  @@unique([roomId, owner, repo])
  @@index([roomId, isActive])
}

/// The draft pull request opened from a successful run. One per run.
model PullRequestLink {
  id         String   @id @default(cuid())
  runId      String   @unique
  provider   String   @default("GITHUB")
  owner      String
  repo       String
  number     Int
  url        String
  headBranch String
  baseBranch String
  commitSha  String?
  state      String   @default("draft")
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/// Append-only event log for a run (state transitions, tool activity).
model RunEvent {
  id          String       @id @default(cuid())
  runId       String
  sequence    Int
  type        RunEventType
  actorType   String       @default("agent")
  actorId     String?
  payloadJson Json?
  // Ingestion idempotency (Agent Dev Room pivot). Set only for events that
  // arrived from an external agent adapter; the built-in runtime writes
  // directly and leaves this null. Unique per run, so replaying a delivery is
  // a no-op rather than a duplicate timeline entry.
  externalEventId String?
  createdAt   DateTime     @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@unique([runId, externalEventId])
  @@index([runId])
}

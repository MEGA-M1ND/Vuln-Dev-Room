// Dev Room — Stage 1 schema.
// PostgreSQL is the single source of truth for all durable application state.
// Liveblocks holds ONLY ephemeral awareness (presence, comment threads) and is
// never persisted here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  ENGINEER
  VIEWER
  // AgentGuard: a dedicated approver. Sees everything an engineer sees and may
  // resolve approval gates, but never starts, steers, or authors work — the
  // separation of duty that makes an approval meaningful rather than a
  // formality the requester can grant themselves. Appended, never reordered.
  REVIEWER
}

enum AgentTaskStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE
}

/// How much scrutiny a task's result deserves. Declared by a human, never
/// inferred from a scan — this is a review-routing hint, not a safety verdict.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// --- Stage 2: coding-agent runs -------------------------------------------

enum AgentRunStatus {
  QUEUED
  RUNNING
  // Stage 3: the agent has produced a plan and is paused before writing any
  // files, waiting for a human approve/reject decision.
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
  // --- Agent Dev Room pivot: states an externally-run agent (or a human)
  // can put a run into. Appended, never reordered — Postgres enum values are
  // append-only, so no existing row changes meaning.
  //
  // The agent stopped and needs a human answer before it can continue.
  WAITING_FOR_INPUT
  // A human marked the run blocked (dependency, decision, missing access).
  BLOCKED
  // Work is finished and awaiting human review, typically with a linked PR.
  REVIEW_READY
  // The linked pull request was merged.
  MERGED
  // Deliberately dropped without merging — distinct from FAILED, which means
  // the run itself broke.
  ABANDONED
}

enum RunArtifactType {
  PLAN
  DIFF
  TEST_RESULT
  SUMMARY
  LOG
  // Phase 5: reviewer-agent's structured review of another run's diff.
  REVIEW
}

enum RunEventType {
  RUN_CREATED
  SANDBOX_PREPARED
  // Phase 1a: a network-enabled setup phase installed the repo's own
  // declared dependencies before the (network-isolated) agent phase began.
  DEPENDENCIES_INSTALLED
  REPOSITORY_INSPECTED
  PLAN_CREATED
  // Stage 3: human-in-the-loop approval gate.
  APPROVAL_REQUESTED
  PLAN_APPROVED
  PLAN_REJECTED
  FILE_PATCHED
  TESTS_STARTED
  TESTS_FINISHED
  DIFF_CAPTURED
  RUN_SUCCEEDED
  RUN_FAILED
  RUN_CANCELLED
  // MVP Phase 1: human control primitives.
  CANCELLATION_REQUESTED
  REDIRECT_REQUESTED
  REDIRECT_APPLIED
  OWNERSHIP_TRANSFERRED
  EDITS_STARTED
  // MVP Phase 3/4: delivery + reuse.
  PR_DRAFTED
  PLAYBOOK_SAVED
  // Phase 1b: iterative repository comprehension.
  TOOL_CALL
  REPO_EXPLORATION_FINISHED
  // Phase 3: guidance arrived and cooperatively aborted an actively-running
  // run (not just one waiting at the approval gate), which then re-planned.
  RUN_STEERED
  // Phase 5: reviewer-agent posted a structured review of another run.
  REVIEW_REQUESTED
  REVIEW_POSTED
  // --- Agent Dev Room pivot: reported by external agent adapters through
  // the ingestion contract. Appended, never reordered.
  AGENT_STARTED
  AGENT_PROGRESS
  COMMAND_EXECUTED
  ERROR_DETECTED
  DECISION_RECORDED
  HANDOFF_REQUESTED
  RISK_FLAGGED
  PR_LINKED
  PR_UPDATED
  REVIEW_READY
  RUN_MERGED
  RUN_ABANDONED
}

/// What kind of human intervention was recorded against a run.
enum RunInterventionKind {
  REDIRECT
  HANDOFF
  CANCEL
}

enum RunInterventionStatus {
  PENDING
  APPLIED
  REJECTED
}

// --- AgentGuard Control Room: governance -----------------------------------

/// What a governed run is permitted to attempt. Chosen by the requester at
/// creation and never widened afterwards — a PLAN_ONLY run cannot decide
/// mid-flight that it would like to write files.
enum RunMode {
  /// Read and reason only. Produces a plan; touches nothing.
  PLAN_ONLY
  /// Check out an existing pull request and run its verification suite.
  VERIFY_PULL_REQUEST
  /// Propose a concrete diff, gated by approval before any PR is created.
  PROPOSE_CODE_CHANGE
}

/// The verbs the policy engine reasons about. Deliberately a closed enum: a
/// policy that cannot name the action it governs is a policy that silently
/// fails open, so new capabilities must be added here consciously.
enum GovernedAction {
  READ_FILE
  RUN_TESTS
  INSPECT_DIFF
  WRITE_FILE
  CREATE_BRANCH
  CREATE_PULL_REQUEST
  PUSH_PROTECTED_BRANCH
  DEPLOY_PRODUCTION
  READ_SECRET
  RUN_COMMAND
}

enum PolicyEffect {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

enum PolicyScope {
  GLOBAL
  ORGANIZATION
  REPOSITORY
}

/// The outcome of evaluating one action against the active policy set.
enum PolicyOutcome {
  ALLOWED
  DENIED
  APPROVAL_REQUIRED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// The run ended (cancelled/failed) before a reviewer answered.
  CANCELLED
}

enum ApprovalDecisionKind {
  APPROVE
  REJECT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdRooms     Room[]           @relation("RoomCreatedBy")
  memberships      RoomMembership[]
  createdTasks     AgentTask[]      @relation("TaskCreatedBy")
  assignedTasks    AgentTask[]      @relation("TaskAssignee")
  requestedRuns    AgentRun[]       @relation("RunRequestedBy")
  ownedRuns        AgentRun[]       @relation("RunOwnedBy")
  interventions    RunIntervention[] @relation("InterventionAuthor")
  createdPlaybooks Playbook[]       @relation("PlaybookCreatedBy")
  githubConnections GitHubConnection[] @relation("GitHubConnectionCreatedBy")
  riskDismissals    RiskSignalDismissal[] @relation("RiskDismissedBy")
  createdPolicies   Policy[]             @relation("PolicyCreatedBy")
  approvalRequests  ApprovalRequest[]    @relation("ApprovalRequestedBy")
  approvalDecisions ApprovalDecision[]   @relation("ApprovalReviewer")

  @@index([email])
}

model Room {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  repositoryName String?
  repositoryUrl  String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy        User                   @relation("RoomCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  memberships      RoomMembership[]
  tasks            AgentTask[]
  agentRuns        AgentRun[]
  playbooks        Playbook[]
  githubConnection GitHubConnection?
  repositories     RepositoryConnection[]
  policyProfiles   PolicyProfile[]
  policies         Policy[]
  policyDecisions  PolicyDecision[]

  @@index([createdById])
}

model RoomMembership {
  id        String         @id @default(cuid())
  roomId    String
  userId    String
  role      MembershipRole @default(ENGINEER)
  createdAt DateTime       @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user has exactly one membership per room.
  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
}

model AgentTask {
  id          String         @id @default(cuid())
  roomId      String
  title       String
  description String?
  status      AgentTaskStatus @default(BACKLOG)
  priority    TaskPriority    @default(MEDIUM)
  assigneeId  String?
  // Fractional-friendly ordering position within a (room, status) column.
  position    Float          @default(0)
  // Optimistic-concurrency token. Starts at 1, incremented on every mutation.
  version     Int            @default(1)
  createdById String

  // --- Agent Dev Room pivot: what the agent is being asked to do, and how
  // much scrutiny the result deserves. All nullable/defaulted so every
  // pre-existing task row remains valid.
  //
  // `objective` is the instruction given to the agent; `description` remains
  // the human-facing context on the board card. They are deliberately separate:
  // a reviewer needs to know what the agent was *told*, not just what the card
  // said.
  objective          String?
  // Definition of done, surfaced to reviewers in the work packet.
  acceptanceCriteria String?
  // Drives risk surfacing and work-queue filtering. Not a security verdict —
  // a human-declared judgement about how much review this change deserves.
  riskLevel          RiskLevel @default(MEDIUM)
  // Which agent is doing the work: "devroom-builtin" for the in-repo LangGraph
  // runtime, or an external adapter ("claude_code", "codex", "cursor",
  // "custom"). Free-form on purpose — new adapters must not require a
  // migration.
  agentProvider      String?
  // GitHub issue this task addresses, if any. A URL rather than an id so it
  // stays meaningful without a live GitHub connection.
  linkedIssueUrl     String?
  // Blockers and questions the team needs to answer, shown on the work packet.
  openQuestions      String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  agentRuns AgentRun[]

  // Board fetch and column ordering: rooms/status/position.
  @@index([roomId, status, position])
  @@index([assigneeId])
  @@index([createdById])
}

/// A single coding-agent execution against a task. Durable state lives here;
/// the Python runtime updates status/artifacts/events. LangGraph checkpoints are
/// stored separately in the `langgraph` schema and are NOT modeled by Prisma.
model AgentRun {
  id                  String         @id @default(cuid())
  roomId              String
  taskId              String
  requestedById       String
  // Phase 1: who is currently responsible for this run. Starts as the
  // requester and changes on hand-off. Does NOT gate other authorized members'
  // safety controls (any OWNER/ENGINEER may still cancel).
  ownerUserId         String?
  agentId             String         @default("backend-agent")
  status              AgentRunStatus @default(QUEUED)
  graphThreadId       String         @unique
  // Sandbox id is operational metadata; never exposed to browser clients.
  sandboxId           String?
  targetRepositoryKey String
  baseRevision        String?
  startedAt           DateTime?
  finishedAt          DateTime?
  errorCode           String?
  errorSummary        String?
  // Phase 1: cooperative cancellation. Set when a human requests a stop; the
  // runtime observes it at the next safe checkpoint and tears down.
  cancelRequestedAt   DateTime?
  cancelRequestedById String?
  // Phase 4: the playbook this run was started from, if any.
  playbookId          String?
  // Fork (roadmap Phase 4): the run this one was forked from, if any. A fork
  // is only ever taken from a run parked at the approval gate — the copied
  // LangGraph checkpoint reproduces that exact paused state on a fresh
  // thread, so the fork starts AWAITING_APPROVAL with the same proposed plan,
  // free to be approved, rejected, or redirected independently of its parent.
  parentRunId         String?
  // The parent's most recent RunEvent.id at the moment of forking — purely
  // informational (never a strict FK; the parent's events keep evolving
  // independently after a fork), so the UI can show "forked after event N".
  forkedAtEvent       String?
  // Reviewer-agent (roadmap Phase 5): the run this one reviews, if any. Unlike
  // a fork, a review run shares the source's OWN task rather than cloning
  // one — it never touches the repository or sandbox, so there is nothing to
  // diverge, and by the time a review can start (source status SUCCEEDED) the
  // task's active-run slot is already free.
  reviewedRunId       String?
  // The external agent session this run represents (Agent Dev Room pivot).
  // Null for the built-in runtime, whose session identity is graphThreadId.
  // Ingestion resolves (taskId, agentSessionId) to a run so an adapter can
  // publish a whole session's events without tracking our run ids.
  agentSessionId      String?
  // --- AgentGuard Control Room: governance metadata -----------------------
  // What this run is allowed to attempt. Fixed at creation; the policy engine
  // reads it as an outer bound on every action the agent proposes.
  mode                RunMode        @default(PROPOSE_CODE_CHANGE)
  // The policy profile in force for the whole run. Captured as a relation so
  // the evidence report can state exactly which ruleset governed it, even if
  // the profile is edited afterwards (decisions themselves are immutable).
  policyProfileId     String?
  // Branch the agent reads from, and the branch it would open a PR from.
  // `baseRevision` remains the resolved commit sha; these are the human-facing
  // branch names the control room and evidence report display.
  baseBranch          String         @default("main")
  workingBranch       String?
  // Aggregate risk for the run, raised as policy decisions accumulate. Seeded
  // from the task's declared level rather than inferred from a scan.
  riskLevel           RiskLevel      @default(MEDIUM)
  // Bumped on every status change (a lightweight change token for polling).
  runVersion          Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Enforces "at most one active run per task" at the DATABASE level: this is
  // set to `taskId` while QUEUED/RUNNING and null once terminal. Postgres
  // permits many NULLs but only one non-null value per task, so two active
  // runs for the same task are impossible even under concurrency. A fork
  // deliberately lives on its OWN cloned task (see `forkRun()`) rather than
  // sharing the parent's, so this invariant never has to be relaxed for it.
  activeTaskId String? @unique

  room          Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  task          AgentTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy   User              @relation("RunRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  owner         User?             @relation("RunOwnedBy", fields: [ownerUserId], references: [id], onDelete: SetNull)
  playbook      Playbook?         @relation("PlaybookRuns", fields: [playbookId], references: [id], onDelete: SetNull)
  parent        AgentRun?         @relation("RunForks", fields: [parentRunId], references: [id], onDelete: SetNull)
  forks         AgentRun[]        @relation("RunForks")
  reviewedRun   AgentRun?         @relation("RunReviews", fields: [reviewedRunId], references: [id], onDelete: SetNull)
  reviews       AgentRun[]        @relation("RunReviews")
  artifacts     RunArtifact[]
  events        RunEvent[]
  interventions RunIntervention[]
  pullRequest   PullRequestLink?
  riskDismissals RiskSignalDismissal[]
  savedPlaybook Playbook?         @relation("PlaybookSourceRun")
  policyProfile    PolicyProfile?    @relation(fields: [policyProfileId], references: [id], onDelete: SetNull)
  policyDecisions  PolicyDecision[]
  approvalRequests ApprovalRequest[]
  evidenceReport   EvidenceReport?

  @@index([taskId, createdAt])
  @@index([roomId])
  @@index([status])
  // Metrics: bounded aggregation by room/status over a date window.
  @@index([roomId, status, createdAt])
  @@index([taskId, status])
  @@index([ownerUserId])
  @@index([parentRunId])
  @@index([reviewedRunId])
  @@index([taskId, agentSessionId])
}

/// An auditable human intervention against a run (redirect, hand-off, cancel).
/// Durable and append-only: this is the record of who steered the agent and why.
model RunIntervention {
  id           String                @id @default(cuid())
  runId        String
  authorUserId String
  kind         RunInterventionKind
  status       RunInterventionStatus @default(PENDING)
  /// REDIRECT: the guidance text a human gave the agent.
  guidance     String?
  /// HANDOFF: previous and new run owner.
  fromUserId   String?
  toUserId     String?
  reason       String?
  createdAt    DateTime              @default(now())
  appliedAt    DateTime?

  run    AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  author User     @relation("InterventionAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([runId, kind, status])
}

/// Append-only durable output of a run (plan, diff, test result, summary, log).
model RunArtifact {
  id          String          @id @default(cuid())
  runId       String
  type        RunArtifactType
  title       String
  contentText String?
  contentJson Json?
  metadataJson Json?
  sequence    Int
  createdAt   DateTime        @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // Monotonic, unique sequence per run — also prevents accidental duplicates.
  @@unique([runId, sequence])
  @@index([runId, type])
}

/// A reusable, sanitized recipe distilled from a successful run.
/// Deliberately stores a *recipe*, never secrets, host paths, sandbox ids or a
/// full private diff.
model Playbook {
  id                     String   @id @default(cuid())
  roomId                 String
  createdById            String
  /// The successful run this playbook was distilled from (at most one).
  sourceRunId            String?  @unique
  title                  String
  description            String?
  /// Simple string tags; Postgres text[] keeps filtering cheap without a join.
  tags                   String[] @default([])
  agentId                String   @default("backend-agent")
  repositoryConnectionId String?
  /// The reusable task instruction template shown to the next user.
  templatePrompt         String
  /// A sanitized outline of the plan that worked.
  planTemplate           String?
  /// Safe, non-secret metadata (e.g. approval expectations, test summary).
  policyJson             Json?
  usageCount             Int      @default(0)
  isArchived             Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  room                 Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy            User                  @relation("PlaybookCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  sourceRun            AgentRun?             @relation("PlaybookSourceRun", fields: [sourceRunId], references: [id], onDelete: SetNull)
  repositoryConnection RepositoryConnection? @relation(fields: [repositoryConnectionId], references: [id], onDelete: SetNull)
  runs                 AgentRun[]            @relation("PlaybookRuns")

  @@index([roomId, isArchived, updatedAt])
}

/// A room's connection to GitHub. Credential material is NEVER serialized to
/// the browser and is referenced indirectly (see lib/github/credentials).
model GitHubConnection {
  id             String   @id @default(cuid())
  roomId         String   @unique
  /// GitHub App installation id or account login, depending on auth mode.
  accountLogin   String
  installationId String?
  /// Opaque reference to server-side credential storage. For local development
  /// this is the literal sentinel "env:GITHUB_TOKEN" (never the token itself).
  credentialRef  String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room         Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("GitHubConnectionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  repositories RepositoryConnection[]

  @@index([roomId])
}

/// A specific GitHub repository a room may open draft PRs against.
model RepositoryConnection {
  id            String   @id @default(cuid())
  roomId        String
  provider      String   @default("GITHUB")
  owner         String
  repo          String
  defaultBranch String   @default("main")
  connectionId  String?
  isActive      Boolean  @default(true)
  // Glob-ish path prefixes a team considers high-blast-radius (e.g.
  // "infra/", "src/auth/"). A task touching one raises a critical-path
  // signal. Team-configured on purpose — we never guess what is critical.
  criticalPaths String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  room       Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  connection GitHubConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  playbooks  Playbook[]

  @@unique([roomId, owner, repo])
  @@index([roomId, isActive])
}

/// A human dismissal of a computed risk signal.
///
/// Signals themselves are COMPUTED on read, never stored: a stored signal
/// goes stale the moment the underlying facts change, and would need a
/// background job to stay honest. Only the dismissal is durable, keyed by the
/// signal's deterministic key, and a reason is mandatory — dismissing is a
/// recorded decision, not a delete.
model RiskSignalDismissal {
  id            String   @id @default(cuid())
  runId         String
  /// Deterministic identity of the dismissed signal (see lib/agent/signals.ts).
  signalKey     String
  dismissedById String
  reason        String
  createdAt     DateTime @default(now())

  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  dismissedBy User     @relation("RiskDismissedBy", fields: [dismissedById], references: [id], onDelete: Cascade)

  @@unique([runId, signalKey])
  @@index([runId])
}

/// The draft pull request opened from a successful run. One per run.
model PullRequestLink {
  id         String   @id @default(cuid())
  runId      String   @unique
  provider   String   @default("GITHUB")
  owner      String
  repo       String
  number     Int
  url        String
  headBranch String
  baseBranch String
  commitSha  String?
  state      String   @default("draft")
  createdById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/// Append-only event log for a run (state transitions, tool activity).
model RunEvent {
  id          String       @id @default(cuid())
  runId       String
  sequence    Int
  type        RunEventType
  actorType   String       @default("agent")
  actorId     String?
  payloadJson Json?
  // Ingestion idempotency (Agent Dev Room pivot). Set only for events that
  // arrived from an external agent adapter; the built-in runtime writes
  // directly and leaves this null. Unique per run, so replaying a delivery is
  // a no-op rather than a duplicate timeline entry.
  externalEventId String?
  // --- AgentGuard: tamper-evident chain -----------------------------------
  // eventHash = SHA-256(previousHash + canonical(event)). `previousHash` is the
  // genesis constant for sequence 1 and the prior event's hash thereafter, so
  // editing or removing any event breaks verification for every event after it.
  //
  // This is an append-only, tamper-EVIDENT log: it proves the chain is
  // internally consistent and detects after-the-fact edits made through the
  // application. It is explicitly NOT a blockchain and offers no defence
  // against an attacker with direct database write access who recomputes the
  // whole chain — that requires external anchoring, noted as future work.
  //
  // Nullable because rows written before this migration have no hash; the
  // verifier reports those as "unchained" rather than failing the run.
  previousHash String?
  eventHash    String?
  createdAt   DateTime     @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  policyDecision PolicyDecision?

  @@unique([runId, sequence])
  @@unique([runId, externalEventId])
  @@index([runId])
}

// --- AgentGuard Control Room: policy, approval, evidence -------------------

/// A named bundle of policies applied to a run as a unit ("Safe / Read-only",
/// "Standard", "Restricted"). Built-in profiles are seeded with `roomId = null`
/// and shared by every organization; a room may define its own.
model PolicyProfile {
  id          String   @id @default(cuid())
  /// Null for a built-in profile available to all organizations.
  roomId      String?
  /// Stable machine key ("safe", "standard", "restricted"). Unique per scope.
  key         String
  name        String
  description String
  /// Chosen by default on the new-run form when the room has no preference.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room     Room?      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  policies Policy[]
  runs     AgentRun[]

  @@unique([roomId, key])
  @@index([roomId])
}

/// A single governance rule. `conditionJson` is a small, closed matcher shape
/// (see `lib/policy-engine/types.ts`) rather than free-form code: a policy
/// engine that evaluates arbitrary expressions is an arbitrary code execution
/// engine, which is precisely what this product exists to prevent.
model Policy {
  id              String       @id @default(cuid())
  policyProfileId String?
  /// Null for a global rule that applies regardless of organization.
  roomId          String?
  name            String
  description     String
  enabled         Boolean      @default(true)
  scope           PolicyScope  @default(GLOBAL)
  conditionJson   Json
  effect          PolicyEffect
  riskLevel       RiskLevel    @default(MEDIUM)
  /// Shown to the user verbatim when this rule decides an action.
  message         String
  /// Lower runs first. DENY rules are seeded below REQUIRE_APPROVAL so an
  /// outright prohibition always wins over "ask a human".
  priority        Int          @default(100)
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  profile   PolicyProfile?   @relation(fields: [policyProfileId], references: [id], onDelete: Cascade)
  room      Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  decisions PolicyDecision[]

  @@index([policyProfileId, priority])
  @@index([roomId])
  @@index([enabled])
}

/// The immutable record of one policy evaluation. Written for every governed
/// action, including allowed ones — an audit trail that only records denials
/// cannot show that anything was checked.
model PolicyDecision {
  id           String         @id @default(cuid())
  runId        String?
  roomId       String
  /// Null when no rule matched and the default (allow) applied.
  policyId     String?
  action       GovernedAction
  outcome      PolicyOutcome
  /// The action's subject: branch, path, command. Never contains secret values.
  resourceJson Json?
  reason       String
  actorType    String         @default("agent")
  actorId      String?
  /// The timeline event this decision produced, when it generated one.
  eventId      String?        @unique
  createdAt    DateTime       @default(now())

  run    AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  room   Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  policy Policy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  event  RunEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([roomId, outcome, createdAt])
  @@index([policyId])
}

/// A protected action parked until a human answers. The run cannot proceed past
/// the requested action while this is PENDING — the gate is enforced in the
/// executor, not merely displayed in the UI.
model ApprovalRequest {
  id            String                @id @default(cuid())
  runId         String
  action        GovernedAction
  status        ApprovalRequestStatus @default(PENDING)
  /// One-line statement of what the agent wants to do.
  summary       String
  /// Structured review context: files changed, diff stat, test results, risk.
  detailsJson   Json?
  /// The rule that forced this gate, for "why am I being asked?".
  policyId      String?
  requestedById String?
  createdAt     DateTime              @default(now())
  resolvedAt    DateTime?

  run         AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  requestedBy User?              @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decisions   ApprovalDecision[]

  // At most one unresolved gate per run: a second concurrent request would make
  // "what is this run waiting for?" ambiguous. Set to `runId` while PENDING and
  // cleared on resolution, so Postgres enforces it rather than application code.
  activeRunId String? @unique

  @@index([runId, createdAt])
  @@index([status, createdAt])
}

/// A reviewer's answer. Append-only and never updated in place: a changed mind
/// is a second decision, so the evidence report shows the full deliberation
/// rather than only its conclusion.
model ApprovalDecision {
  id                String               @id @default(cuid())
  approvalRequestId String
  reviewerId        String
  decision          ApprovalDecisionKind
  comment           String?
  createdAt         DateTime             @default(now())

  request  ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  reviewer User            @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId, createdAt])
  @@index([reviewerId])
}

/// A finalized, downloadable evidence bundle for a completed run.
///
/// Materialized once the run reaches a terminal state: the point of an evidence
/// report is that it is a snapshot of what was true at completion, so it is
/// stored rather than recomputed on every view. `integrityVerified` records the
/// hash-chain result AT GENERATION TIME; the report page re-verifies live and
/// shows both, which is what makes later tampering visible.
model EvidenceReport {
  id                String   @id @default(cuid())
  runId             String   @unique
  reportJson        Json
  integrityVerified Boolean
  /// Number of events covered by the chain at generation time.
  eventCount        Int      @default(0)
  /// The final event's hash — the single value that fingerprints the whole run.
  chainHead         String?
  riskLevel         RiskLevel
  generatedAt       DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([generatedAt])
}

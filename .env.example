# ---------------------------------------------------------------------------
# Dev Room — Stage 1 environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (source of truth for all durable state).
# In production, point this at a POOLED connection (e.g. a PgBouncer
# transaction-mode pooler) — the Prisma Client uses it for runtime queries.
DATABASE_URL="postgresql://devroom:devroom@127.0.0.1:5432/devroom?schema=public"

# Non-pooled (session/direct) connection used ONLY by `prisma migrate deploy`.
# Migrations need a session-scoped advisory lock, which a transaction-mode
# pooler cannot provide. Locally this is the same DB as DATABASE_URL.
DIRECT_URL="postgresql://devroom:devroom@127.0.0.1:5432/devroom?schema=public"

# NextAuth / Auth.js — required. Generate with: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used by Auth.js).
NEXTAUTH_URL="http://localhost:3000"

# Enables the development-only "sign in as seeded user" switcher.
# MUST be unset/false in production. The Credentials provider is only
# registered when this is "true" AND NODE_ENV !== "production".
DEV_AUTH_ENABLED="true"

# ---------------------------------------------------------------------------
# GitHub OAuth — the only sign-in path available in production, since the
# switcher above is inert once NODE_ENV=production. Without these a deployed
# instance has no way to sign in at all.
# Create at https://github.com/settings/applications/new with callback URL
# <NEXTAUTH_URL>/api/auth/callback/github
# ---------------------------------------------------------------------------
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Liveblocks — realtime presence + comment threads.
# Free tier is sufficient for Stage 1: https://liveblocks.io/dashboard
# The board (Postgres) works without these, but presence/comments need them.
# ---------------------------------------------------------------------------
LIVEBLOCKS_SECRET_KEY=""
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# Stage 2 — agent runtime (server-only; never exposed to the browser)
# The Python agent-runtime service must be running for agent runs to work.
# ---------------------------------------------------------------------------
DEVROOM_AGENT_SERVICE_URL="http://127.0.0.1:8787"
# Shared internal token; MUST match the runtime's DEVROOM_AGENT_SERVICE_TOKEN.
# When empty, the agent UI shows as "not configured" and no runs can start.
DEVROOM_AGENT_SERVICE_TOKEN=""
# Repository registry key runs default to (validated by the runtime).
DEVROOM_DEFAULT_REPOSITORY_KEY="demo-service"
# The runtime posts run updates to /api/internal/agent-callback using
# DEVROOM_AGENT_SERVICE_TOKEN; the web app then broadcasts RUN_UPDATED over
# Liveblocks. No extra web env is needed beyond the token above.

# ---------------------------------------------------------------------------
# GitHub delivery (OPTIONAL, disabled by default)
# Draft pull requests from successful runs. The app works fully without this;
# the UI shows a clear "not configured" state. BOTH the flag and a credential
# are required before any GitHub call is attempted.
# ---------------------------------------------------------------------------
DEVROOM_GITHUB_ENABLED="false"
# LOCAL DEVELOPMENT ONLY: a personal access token with `repo` scope.
# For production use a GitHub App instead (see README "GitHub integration") and
# mint short-lived installation tokens server-side. Never commit a token.
GITHUB_TOKEN=""
# Override for GitHub Enterprise. Defaults to the public API.
# GITHUB_API_BASE_URL="https://api.github.com"

# ---------------------------------------------------------------------------
# External agent-event ingestion (optional)
# Lets a coding-agent adapter (Claude Code, Codex, Cursor, custom) publish
# session events into a room via POST /api/agent-events.
#
# DELIBERATELY SEPARATE from DEVROOM_AGENT_SERVICE_TOKEN: that token
# authenticates our own runtime's privileged callbacks, and handing it to a
# third-party adapter would let the adapter impersonate the runtime. Leave
# this unset and ingestion reports itself as not configured.
#
# See docs/agent-event-contract.md.
# ---------------------------------------------------------------------------
DEVROOM_INGEST_TOKEN=""

# ---------------------------------------------------------------------------
# Risk & conflict signal thresholds (optional)
# Transparent heuristics over active work, not security analysis. Tune to your
# repo; every signal states the threshold it fired against.
# ---------------------------------------------------------------------------
# Files touched before a task is flagged for scope growth (default 15).
# DEVROOM_SCOPE_GROWTH_FILES="15"
# Minutes without activity before a RUNNING run is flagged stalled (default 60).
# DEVROOM_STALLED_MINUTES="60"

# ---------------------------------------------------------------------------
# Demo affordances (never enabled in production)
# Adds a "Create sample ticket" button to an empty room. No data is ever
# seeded silently.
# ---------------------------------------------------------------------------
DEVROOM_DEMO_MODE="false"

# ---------------------------------------------------------------------------
# Playwright e2e (optional)
# ---------------------------------------------------------------------------
# E2E_BASE_URL="http://localhost:3000"
